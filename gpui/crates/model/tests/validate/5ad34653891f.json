{
  "schemaVersion": 1,
  "project": {
    "name": "Contracts"
  },
  "types": [
    {
      "kind": "enum",
      "name": "Mode",
      "underlying": "uint8",
      "values": [
        {
          "name": "Idle",
          "value": 0
        },
        {
          "name": "Run",
          "value": 1
        }
      ]
    }
  ],
  "interfaces": [],
  "constants": [
    {
      "name": "Limit",
      "type": {
        "kind": "primitive",
        "name": "uint32"
      },
      "value": 100
    }
  ],
  "modules": [
    {
      "name": "Stack",
      "invariants": [
        "value > 0"
      ],
      "attributes": [
        {
          "name": "count",
          "type": {
            "kind": "primitive",
            "name": "uint32"
          },
          "default": 0
        },
        {
          "name": "mode",
          "type": {
            "kind": "ref",
            "name": "Mode"
          },
          "default": "Idle"
        }
      ],
      "methods": [
        {
          "name": "push",
          "params": [
            {
              "name": "value",
              "type": {
                "kind": "primitive",
                "name": "int32"
              }
            }
          ],
          "returns": null,
          "pre": [
            "count < Limit"
          ],
          "post": [
            "result > 0"
          ]
        },
        {
          "name": "top",
          "const": true,
          "params": [],
          "returns": {
            "kind": "primitive",
            "name": "int32"
          },
          "pre": [
            "count > 0"
          ],
          "post": [
            "result == items[count - 1]"
          ]
        }
      ],
      "ports": []
    }
  ],
  "links": [],
  "editor": {
    "layout": {
      "Stack": {
        "x": 20,
        "y": 20,
        "width": 200,
        "height": 160
      }
    }
  }
}
