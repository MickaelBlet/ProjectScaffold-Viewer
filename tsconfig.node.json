{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["node"],
    "paths": { "@/*": ["./src/renderer/src/*"] }
  },
  "include": ["vite.config.ts", "vitest.config.ts", "scripts/**/*", "tests/**/*", "src/renderer/src/model/**/*"]
}
