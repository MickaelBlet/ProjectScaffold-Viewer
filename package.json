{
  "name": "project-scaffold",
  "version": "0.1.0",
  "description": "Browser-based software architecture editor exporting YAML/JSON for code skeleton generators",
  "author": "Mickaël Blet",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.web.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "schema": "tsx scripts/gen-schema.ts",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "dockview-react": "^8.3.1",
    "elkjs": "^0.12.0",
    "html-to-image": "^1.11.13",
    "immer": "^11.1.18",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@xyflow/react": "^12.11.6",
    "ajv": "^8.20.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^7.3.6",
    "vitest": "^5.0.1",
    "zundo": "^2.3.0",
    "zustand": "^5.0.15"
  }
}
