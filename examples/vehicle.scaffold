syntax = "scaffold1";

/// Electric car split into ECUs on a CAN bus; modules nested in the ECUs, their ports forwarded through the container's; generated in C++11
project "Vehicle" [metadata = { version: "0.3.0", safety: "ASIL-B" }];

/// Motor and battery ECU
binary Powertrain;
/// Brakes and steering ECU
binary Chassis;
/// Dashboard and infotainment
binary Cockpit;
/// Workshop tester on the OBD port
binary Diagnostics;

enum Gear : uint8 {
  Park = 0;
  Reverse = 1;
  Neutral = 2;
  Drive = 3;
}

bitmask Faults : uint32 {
  OverTemp = 1 << 0;
  UnderVoltage = 1 << 1;
  OverCurrent = 1 << 2;
  SensorLost = 1 << 3;
  BusOff = 1 << 4;
}

struct Torque {
  int16 requestedNm;
  Gear gear = Park;
}

struct BatteryState {
  uint8 socPercent;
  float32 voltage;
  float32 current;
  array<int8, 8> cellTemps;
}

struct WheelSpeeds {
  /// FL
  array<int16, 4> rpm;
}

/// Diagnostic trouble code
struct Dtc {
  uint32 code;
  Faults faults;
  uint16 occurrences = 1;
}

interface TorqueCommand {
  void request(Torque torque);
}

interface BatteryStatus {
  void state(BatteryState state);
}

interface WheelStatus {
  void speeds(WheelSpeeds speeds);
}

interface Brake {
  void pressure(float32 bar);
}

interface Diagnosis {
  vector<Dtc, 32> readDtcs();
  bool clearDtcs();
}

const int16 MaxTorqueNm = 310;
const uint32 CanBitrate = 500000;

/// Vehicle control unit
module Vcu {
  binary = Powertrain;

  in WheelStatus wheels;
  out Brake brake;
  out BatteryStatus battery;
  in Diagnosis diagnosis;

  /// Reads the accelerator, asks for torque
  module Pedals {
    uint8 deadZone = 3;

    out TorqueCommand torque;
  }

  /// Limits torque when the wheels slip
  module TractionControl {
    float32 slipLimit = 0.12;

    in WheelStatus wheels;
    in TorqueCommand torqueIn;
    out TorqueCommand torqueOut;
    out Brake brake;
  }

  module Inverter {
    uint16 switchingKHz = 10;

    in TorqueCommand torque;
  }

  /// Battery management
  module Bms {
    static const uint8 CELLS = 96;
    int8 maxCellTemp = 55;
    Faults faults = [];

    out BatteryStatus state;
  }

  /// Diagnostic event manager
  module Dem {
    in Diagnosis diagnosis;
  }
}

/// Electronic stability control
module Esc {
  binary = Chassis;

  out WheelStatus wheels;
  in Brake brake;

  module WheelSensors {
    uint8 teeth = 48;

    out WheelStatus speeds;
  }

  module Hydraulics {
    in Brake pressure;
  }
}

module Dashboard {
  binary = Cockpit;

  in BatteryStatus battery;
}

module Tester {
  binary = Diagnostics;

  out Diagnosis diagnosis;
}

link pedals_to_traction: Vcu.Pedals.torque -> Vcu.TractionControl.torqueIn realtime latency 1 rate 1000;
link traction_to_inverter: Vcu.TractionControl.torqueOut -> Vcu.Inverter.torque realtime latency 1 rate 1000;
link wheels_in: Vcu.wheels -> Vcu.TractionControl.wheels realtime latency 1 rate 1000;
link brake_out: Vcu.TractionControl.brake -> Vcu.brake realtime latency 1 rate 1000;
link battery_out: Vcu.Bms.state -> Vcu.battery low rate 10;
link diagnosis_in: Vcu.diagnosis <-> Vcu.Dem.diagnosis low;
link speeds_out: Esc.WheelSensors.speeds -> Esc.wheels realtime latency 1 rate 1000;
link pressure_in: Esc.brake -> Esc.Hydraulics.pressure realtime latency 1 rate 1000;
link wheel_speeds: Esc.wheels -> Vcu.wheels realtime latency 5 rate 100 remote can { interface: can0, id: 416 };
link brake_request: Vcu.brake -> Esc.brake realtime latency 5 rate 100 remote can { interface: can0, id: 432 };
link battery_display: Vcu.battery -> Dashboard.battery low rate 10 remote can { interface: can1, id: 960 };
link obd: Tester.diagnosis <-> Vcu.diagnosis ack 2000 low remote can { interface: can1, id: 2016, options: { protocol: UDS, response: "0x7E8" } };

editor = {
  layout: {
    Vcu: { x: 579, y: 20, width: 1144, height: 546 },
    Vcu.Pedals: { x: 151, y: 166, width: 200, height: 98 },
    Vcu.TractionControl: { x: 467, y: 225, width: 200, height: 122 },
    Vcu.Inverter: { x: 783, y: 330, width: 200, height: 98 },
    Vcu.Bms: { x: 781, y: 144, width: 200, height: 116 },
    Vcu.Dem: { x: 153, y: 334, width: 200, height: 72 },
    Esc: { x: 20, y: 34, width: 443, height: 306 },
    Esc.WheelSensors: { x: 99, y: 188, width: 200, height: 98 },
    Esc.Hydraulics: { x: 101, y: 46, width: 200, height: 72 },
    Dashboard: { x: 1839, y: 257, width: 200, height: 72 },
    Tester: { x: 142, y: 481, width: 200, height: 72 }
  },
  style: {
    Vcu: { color: "#d1733b" },
    Esc: { color: "#2e9e8f" },
    Dashboard: { color: "#3b8fd1" },
    Tester: { color: "#6b7f8e" }
  },
  binaries: {
    Powertrain: { color: "#d1733b" },
    Chassis: { color: "#2e9e8f" },
    Cockpit: { color: "#3b8fd1" },
    Diagnostics: { color: "#6b7f8e" }
  }
};
