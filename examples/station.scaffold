syntax = "scaffold1";

/// Ground station monitoring the robot
project "Station";

module Monitor {
  /// Smoothing asked of the robot's sensors
  Robot/Core.Sensor.Filter filter = None;

  in Telemetry telemetry;
  out Control control;
}

module Operator {
  in Control control;
}

link monitor_to_operator: Monitor.control <-> Operator.control;
link sensor_to_monitor: Robot/Core.Sensor.out -> Monitor.telemetry remote tcp;

dependency Common "common.scaffold" {
  struct Vec3 {
    float32 x;
    float32 y;
    float32 z;
  }

  enum Mode : uint8 {
    Idle = 0;
    Run = 1;
    Fault = 255;
  }

  alias Samples = vector<uint16>;

  /// Position and orientation
  struct Pose {
    Vec3 position;
    array<float64, 4> orientation = [0, 0, 0, 1];
  }

  interface Telemetry {
    void publish(Pose pose, map<string, list<uint8>> tags);
  }

  interface Control {
    bool setMode(Mode mode);
    void raw(inout Samples samples, optional<float32> gain);
  }
}

dependency Robot "robot.scaffold" {
  primitive Primitive;

  uses = [Common];

  moduleTypes = [
    {
      module: Core.Sensor,
      types: [
        {
          kind: enum,
          name: Filter,
          description: "Smoothing of the readings",
          underlying: uint8,
          values: [{ name: None, value: 0 }, { name: LowPass, value: 1 }]
        },
        {
          kind: struct,
          name: Sample,
          access: protected,
          fields: [
            { name: value, type: { kind: primitive, name: float32 } },
            { name: stampUs, type: { kind: primitive, name: uint64 } }
          ]
        }
      ]
    }
  ];

  modules = [
    { module: Core, ports: [{ name: control, role: in, interface: Control }] },
    {
      module: Core.Sensor,
      attributes: [
        { name: rateHz, type: { kind: primitive, name: float32 }, default: 50 },
        {
          name: maxRateHz,
          access: protected,
          static: true,
          const: true,
          type: { kind: primitive, name: float32 },
          default: 200
        },
        { name: filter, type: { kind: ref, name: "Robot/Core.Sensor.Filter" }, default: LowPass },
        { name: last, access: protected, type: { kind: ref, name: "Robot/Core.Sensor.Sample" } }
      ],
      ports: [{ name: out, role: out, interface: Telemetry }]
    },
    {
      module: Core.Controller,
      attributes: [{ name: mode, type: { kind: ref, name: Mode }, default: Idle }],
      methods: [
        {
          name: setMode,
          description: "Switch mode, false when the transition is not allowed",
          params: [{ name: mode, type: { kind: ref, name: Mode }, const: true }],
          returns: { kind: primitive, name: bool }
        },
        {
          name: tune,
          description: "Smoothing the sensors should use",
          params: [{ name: filter, type: { kind: ref, name: "Robot/Core.Sensor.Filter" } }],
          returns: null
        },
        { name: reset, access: protected, params: [], returns: null },
        {
          name: isRunning,
          access: private,
          const: true,
          params: [],
          returns: { kind: primitive, name: bool }
        },
        {
          name: instances,
          description: "Number of controllers alive",
          static: true,
          params: [],
          returns: { kind: primitive, name: uint32 }
        }
      ],
      ports: [{ name: telemetry, role: in, interface: Telemetry }]
    },
    { module: Core.Logger, ports: [{ name: in, role: in, interface: Telemetry }] }
  ];
}

editor = {
  layout: {
    Monitor: { x: 20, y: 20, width: 200, height: 72 },
    Operator: { x: 300, y: 20, width: 200, height: 72 }
  },
  dependencies: {
    Robot: {
      Core: { x: 660, y: 20, width: 700, height: 420 },
      Core.Sensor: { x: 100, y: 120, width: 260, height: 280 },
      Core.Controller: { x: 460, y: 40, width: 220, height: 240 },
      Core.Logger: { x: 460, y: 320, width: 200, height: 80 }
    }
  }
};
