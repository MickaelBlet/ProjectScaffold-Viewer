syntax = "scaffold1";

/// Home automation split into binaries talking over every built-in transport (ipc, shm, tcp, udp, http, grpc, websocket, mqtt, can, serial) and a custom one
project "Home";

transports = [zigbee];

remoteDefaults = { client: { host: hub.local }, server: { host: "0.0.0.0" }, basePort: 52000 };

/// Home server process
binary Hub;
/// Camera process on the hub box
binary Vision;
/// Speech assistant process on the hub box
binary Voice;
/// Remote service
binary Cloud;
/// Phone app
binary Mobile;
/// Microcontrollers of the devices
binary Firmware;

alias DeviceId = string(16);

enum Quantity : uint8 {
  Temperature = 0;
  Humidity = 1;
  Motion = 2;
  Door = 3;
  Power = 4;
}

struct Reading {
  DeviceId device;
  Quantity quantity;
  float32 value;
  uint64 stampMs;
}

struct Frame {
  DeviceId camera;
  bytes jpeg;
}

struct Event {
  string(64) title;
  optional<DeviceId> device = null;
  optional<Frame> snapshot = null;
}

struct Rule {
  string(32) name;
  /// Condition on readings
  string when;
  /// Commands to run
  vector<string> then;
  bool enabled = true;
}

struct Intent {
  string(24) verb;
  DeviceId target;
  optional<float32> value = null;
}

interface Readings {
  void report(Reading reading);
}

interface Switch {
  void set(
    bool on,
    /// 0-100
    uint8 level
  );
}

interface Climate {
  bool setTarget(float32 celsius);
  Reading current();
}

interface Frames {
  void push(Frame frame);
}

interface Intents {
  string intent(Intent intent);
}

interface Events {
  void notify(Event event);
}

interface Rules {
  vector<Rule> list();
  void upsert(Rule rule);
}

interface Backup {
  void upload(string name, bytes data);
}

/// Devices announcing themselves on the network
interface Presence {
  void hello(DeviceId device);
}

/// Runs the rules on the readings
module Automation {
  binary = Hub;

  in Readings readings;
  in Frames frames;
  in Intents intents;
  in Presence presence;
  out Switch lights;
  out Climate heating;
  out Events events;
  out Rules rules;
  out Backup backup;
}

module Camera {
  binary = Vision;

  uint8 fps = 10;

  out Frames frames;
}

module Assistant {
  binary = Voice;

  string wakeWord = "hey home";

  out Intents intents;
}

/// Stores rules and events, sends notifications
module Service {
  binary = Cloud;

  in Events events;
  in Rules rules;
  in Backup backup;
  out Events push;
}

module App {
  binary = Mobile;

  out Rules rules;
  in Events events;
}

/// Battery sensors on the Zigbee mesh
module Sensors {
  binary = Firmware;

  out Readings readings;
}

module Lights {
  binary = Firmware;

  in Switch switch;
}

/// Boiler controller wired to the hub
module Boiler {
  binary = Firmware;

  in Climate climate;
  out Readings meter;
}

module Doorbell {
  binary = Firmware;

  out Presence presence;
}

/// Same box, large payloads
link camera_frames: Camera.frames -> Automation.frames realtime latency 20 rate 10 remote shm { name: home_frames, capacity: 8388608 };
link voice_intents: Assistant.intents <-> Automation.intents latency 300 remote ipc { socket: "/run/home/intents.sock" };
link sensor_readings: Sensors.readings -> Automation.readings low remote zigbee { options: { channel: "15", panId: "0x1A62", coordinator: "/dev/ttyACM0" } };
link light_switch: Automation.lights <-> Lights.switch ack 1000 remote mqtt { broker: { host: hub.local, port: 1883 }, topic: "home/lights/set" };
link boiler_control: Automation.heating <-> Boiler.climate ack 500 low remote serial { device: "/dev/ttyUSB0", baud: 115200 };
link boiler_meter: Boiler.meter -> Automation.readings low rate 1 remote can { interface: can0, id: 291 };
link doorbell_presence: Doorbell.presence -> Automation.presence low remote udp { server: { port: 52100 } };
link cloud_events: Automation.events <-> Service.events ack 5000 remote grpc { client: { host: api.home.example, port: 443 }, server: { port: 8443 } };
/// Address from remoteDefaults
link cloud_rules: Automation.rules <-> Service.rules low remote tcp;
link cloud_backup: Automation.backup <-> Service.backup ack 60000 bulk remote http { client: { host: api.home.example, port: 443 }, path: "/v1/backup" };
link app_rules: App.rules <-> Service.rules remote http { client: { host: api.home.example, port: 443 }, path: "/v1/rules" };
link app_events: Service.push -> App.events remote websocket { server: { port: 8444 }, path: "/v1/live" };

editor = {
  layout: {
    Automation: { x: 336, y: 211, width: 200, height: 168 },
    Camera: { x: 20, y: 162, width: 200, height: 98 },
    Assistant: { x: 20, y: 330, width: 200, height: 98 },
    Service: { x: 652, y: 377, width: 200, height: 120 },
    App: { x: 968, y: 259, width: 200, height: 72 },
    Sensors: { x: 20, y: 20, width: 200, height: 72 },
    Lights: { x: 652, y: 93, width: 200, height: 72 },
    Boiler: { x: 652, y: 235, width: 200, height: 72 },
    Doorbell: { x: 20, y: 498, width: 200, height: 72 }
  },
  style: {
    Automation: { color: "#2e9e8f" },
    Camera: { color: "#8a4fd1" },
    Assistant: { color: "#d14f9e" },
    Service: { color: "#3b8fd1" },
    App: { color: "#d6c21f" },
    Sensors: { color: "#d1733b" },
    Lights: { color: "#d1733b" },
    Boiler: { color: "#d1733b" },
    Doorbell: { color: "#d1733b" }
  },
  binaries: {
    Hub: { color: "#2e9e8f" },
    Vision: { color: "#8a4fd1" },
    Voice: { color: "#d14f9e" },
    Cloud: { color: "#3b8fd1" },
    Mobile: { color: "#d6c21f" },
    Firmware: { color: "#d1733b" }
  }
};
