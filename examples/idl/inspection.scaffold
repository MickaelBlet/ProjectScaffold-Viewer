syntax = "scaffold1";

/// Optical inspection station built on imaging.idl - places its Imaging module (Grabber, Viewer components) and uses the types of that IDL module
project "Inspection";

enum Verdict : uint8 {
  Pass = 0;
  Fail = 1;
  Unsure = 2;
}

struct Defect {
  imaging/Imaging.Roi where;
  string(24) kind;
  float32 score;
}

interface Results {
  void inspected(uint64 part, Verdict verdict, vector<Defect, 16> defects);
}

/// Finds defects in the frames
module Inspector {
  imaging/Imaging.PixelFormat format = MONO8;
  imaging/Imaging.Roi roi = { x: 200, y: 100, width: 1280, height: 720 };
  float32 threshold = 0.8;

  out Camera camera;
  in FrameListener frames;
  out Results results;
  out FrameListener preview;
}

/// Pushes failed parts off the conveyor
module Reject {
  in Results results;
}

link configure_camera: Inspector.camera <-> imaging/Imaging.Grabber.camera;
link frames_in: imaging/Imaging.Grabber.listeners -> Inspector.frames realtime latency 30 rate 30;
/// Frames with the defects drawn
link preview: Inspector.preview -> imaging/Imaging.Viewer.frames low rate 10;
link verdicts: Inspector.results -> Reject.results realtime latency 50;

dependency imaging "imaging.idl" {
  /// Handle the platform gives to frame buffers.
  primitive BufferHandle;

  interface Camera {
    imaging/Imaging.Register get_settings();
    void configure(imaging/Imaging.PixelFormat format, imaging/Imaging.Roi roi);
    imaging/Imaging.Frame grab() raises (imaging/Imaging.NotStreaming);
    sensors_dds/Sensors.Health health();
  }

  interface FrameListener {
    void onFrame(imaging/Imaging.Frame frame);
  }

  /// What a processing step reports.
  interface Annotated {
    imaging/Imaging.Label caption();
  }

  const uint16 WIDTH = 1920;

  const uint16 HEIGHT = 1080;

  const uint32 PIXELS = 2073600;

  const float64 GAMMA = 2.2;

  const string VENDOR = "Example Optics";

  uses = [sensors_dds];

  moduleTypes = [
    {
      module: Imaging,
      types: [
        {
          kind: struct,
          name: Roi,
          description: "Region of interest.",
          fields: [
            { name: x, type: { kind: primitive, name: uint16 } },
            { name: y, type: { kind: primitive, name: uint16 } },
            { name: width, type: { kind: primitive, name: uint16 }, default: 1920 },
            { name: height, type: { kind: primitive, name: uint16 }, default: 1080 }
          ]
        },
        {
          kind: enum,
          name: PixelFormat,
          underlying: int32,
          values: [
            { name: MONO8, value: 0 },
            { name: RGB24, value: 1 },
            { name: BAYER_RG8, value: 2 },
            { name: YUV422, value: 3 }
          ]
        },
        {
          kind: struct,
          name: Register,
          description: "Packed sensor register.",
          fields: [
            { name: gain, type: { kind: primitive, name: uint8 }, description: "4 bits." },
            { name: binning, type: { kind: primitive, name: uint8 }, description: "3 bits." },
            { name: enabled, type: { kind: primitive, name: bool }, description: "1 bits." }
          ]
        },
        {
          kind: struct,
          name: Frame,
          description: "Frame shared by value.",
          fields: [
            { name: format, type: { kind: ref, name: "imaging/Imaging.PixelFormat" } },
            { name: roi, type: { kind: ref, name: "imaging/Imaging.Roi" } },
            { name: pixels, type: { kind: primitive, name: bytes } },
            { name: buffer, type: { kind: ref, name: BufferHandle } }
          ]
        },
        {
          kind: alias,
          name: Label,
          description: "Text maybe absent: a boxed value.",
          type: { kind: optional, of: { kind: primitive, name: string } }
        },
        { kind: exception, name: NotStreaming, fields: [] }
      ]
    },
    {
      module: Imaging.Exposures,
      types: [
        {
          kind: struct,
          name: Ring,
          fields: [
            { name: items, type: { kind: array, of: { kind: primitive, name: float64 }, size: 16 } },
            { name: head, type: { kind: primitive, name: uint32 } }
          ]
        }
      ]
    }
  ];

  modules = [
    { module: Imaging, ports: [] },
    {
      module: Imaging.Grabber,
      attributes: [{ name: fps, type: { kind: primitive, name: uint16 } }],
      ports: [
        { name: camera, role: in, interface: Camera },
        {
          name: listeners,
          role: out,
          interface: FrameListener,
          description: "Multiple connections."
        }
      ]
    },
    { module: Imaging.Viewer, ports: [{ name: frames, role: in, interface: FrameListener }] },
    {
      module: Imaging.SharedFrames,
      ports: [
        { name: sink, role: in, interface: FrameListener },
        { name: source, role: out, interface: FrameListener }
      ]
    },
    { module: Imaging.Exposures, ports: [] }
  ];
}

dependency sensors_dds "sensors_dds.idl" {
  const int32 MAX_POINTS = 1024;

  const int32 MAX_ID = 16;

  indirect = true;

  moduleTypes = [
    {
      module: Sensors,
      types: [
        {
          kind: enum,
          name: Health,
          underlying: int32,
          values: [{ name: OK, value: 0 }, { name: DEGRADED, value: 10 }, { name: FAILED, value: 20 }]
        },
        {
          kind: bitmask,
          name: Capabilities,
          underlying: uint8,
          flags: [{ name: RANGE, bit: 0 }, { name: INTENSITY, bit: 1 }, { name: VELOCITY, bit: 4 }]
        },
        {
          kind: struct,
          name: Point,
          description: "Point of a scan, in the sensor frame (meters).",
          fields: [
            { name: x, type: { kind: primitive, name: float32 } },
            { name: y, type: { kind: primitive, name: float32 } },
            { name: z, type: { kind: primitive, name: float32 } },
            { name: intensity, type: { kind: optional, of: { kind: primitive, name: float32 } } }
          ]
        },
        {
          kind: struct,
          name: Header,
          description: "Header of every sample.",
          fields: [
            { name: sensorId, type: { kind: primitive, name: string, max: 16 } },
            {
              name: stampNs,
              type: { kind: primitive, name: uint64 },
              description: "since the epoch"
            },
            { name: counter, type: { kind: primitive, name: uint32 } }
          ]
        },
        {
          kind: struct,
          name: Scan,
          fields: [
            { name: sensorId, type: { kind: primitive, name: string, max: 16 } },
            {
              name: stampNs,
              type: { kind: primitive, name: uint64 },
              description: "since the epoch"
            },
            { name: counter, type: { kind: primitive, name: uint32 } },
            {
              name: points,
              type: { kind: vector, of: { kind: ref, name: "sensors_dds/Sensors.Point" }, max: 1024 }
            },
            { name: capabilities, type: { kind: ref, name: "sensors_dds/Sensors.Capabilities" } }
          ]
        },
        {
          kind: struct,
          name: Status,
          fields: [
            { name: sensorId, type: { kind: primitive, name: string, max: 16 } },
            {
              name: stampNs,
              type: { kind: primitive, name: uint64 },
              description: "since the epoch"
            },
            { name: counter, type: { kind: primitive, name: uint32 } },
            { name: health, type: { kind: ref, name: "sensors_dds/Sensors.Health" } },
            {
              name: temperatures,
              type: {
                kind: map,
                key: { kind: primitive, name: string },
                value: { kind: primitive, name: float64 }
              },
              description: "by probe name"
            },
            {
              name: diagnostics,
              type: { kind: primitive, name: bytes },
              description: "vendor blob"
            }
          ]
        },
        {
          kind: union,
          name: Reading,
          description: "Raw reading: a struct of its discriminator and one optional field per case.",
          discriminator: { kind: primitive, name: int32 },
          cases: [
            { name: range, type: { kind: primitive, name: float32 }, labels: [0] },
            { name: point, type: { kind: ref, name: "sensors_dds/Sensors.Point" }, labels: [1] },
            { name: text, type: { kind: primitive, name: string }, default: true }
          ]
        }
      ]
    }
  ];
}

editor = {
  layout: {
    Inspector: { x: 900, y: 60, width: 200, height: 182 },
    Reject: { x: 1220, y: 60, width: 200, height: 72 }
  },
  style: { Inspector: { color: "#2e9e8f" }, Reject: { color: "#d1733b" } },
  dependencies: {
    imaging: {
      Imaging: { x: 20, y: 20, width: 780, height: 330 },
      Imaging.Grabber: { x: 540, y: 60, width: 200, height: 98 },
      Imaging.Viewer: { x: 540, y: 220, width: 200, height: 72 },
      Imaging.SharedFrames: { x: 20, y: 200, width: 200, height: 98 },
      Imaging.Exposures: { x: 20, y: 60, width: 200, height: 72 }
    }
  }
};
