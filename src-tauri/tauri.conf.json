{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ProjectScaffold",
  "version": "../package.json",
  "identifier": "com.mickaelblet.projectscaffold",
  "build": {
    "frontendDist": "../dist-web",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "ProjectScaffold",
        "width": 1400,
        "height": 900,
        "minWidth": 640,
        "minHeight": 400,
        "decorations": false,
        "visible": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": { "webviewInstallMode": { "type": "downloadBootstrapper" } }
  }
}
